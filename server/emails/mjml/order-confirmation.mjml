<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      .cta-button a { color: #ffffff !important; text-decoration: none !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Header -->
    <mj-section background-color="#000000" padding="30px 20px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="28px" font-weight="700">
          {{appName}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content -->
    <mj-section background-color="#ffffff" padding="40px 30px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" color="#000000" padding-bottom="20px">
          {{title}}
        </mj-text>
        <mj-text>
          {{greeting}}
        </mj-text>
        <mj-text padding-top="20px">
          {{orderSummary}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Order details -->
    <mj-section background-color="#f9f9f9" padding="20px 30px">
      <mj-column>
        <mj-text font-weight="700" font-size="14px" color="#666666" text-transform="uppercase" letter-spacing="1px">
          Order Details
        </mj-text>
        <mj-divider border-color="#e0e0e0" border-width="1px" padding="10px 0" />
        <mj-text>
          {{orderDetails}}
        </mj-text>
        <mj-divider border-color="#e0e0e0" border-width="1px" padding="10px 0" />
        <mj-text font-size="20px" font-weight="700" color="#000000">
          Total: {{totalAmount}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="30px">
      <mj-column>
        <mj-button background-color="#000000" color="#ffffff" font-size="16px" font-weight="600" inner-padding="15px 40px" border-radius="0" css-class="cta-button" href="{{ctaUrl}}">
          {{ctaText}}
        </mj-button>
        <mj-text padding-top="20px" font-size="14px" color="#666666">
          {{nextSteps}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f4f4f4" padding="20px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#999999">
          {{footerText}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
